            'Os troncos gigantes das árvores centenárias da mata',
            'O silêncio fresco do bosque longe do trânsito'
          ]
        }
      ];

      var ZONES = [
        { name: '🏠 Bairro 1º de Maio', coords: [40.6609, -7.9202], radius: 135, kind: 'start' },
        { name: '🌿 Rossio & Aquilino', coords: [40.6568, -7.9140], radius: 220, kind: 'green' },
        { name: '✨ Centro Histórico · Sé', coords: [40.6584, -7.9110], radius: 210, kind: 'heritage' },
        { name: '🦚 Mata do Fontelo', coords: [40.6615, -7.9035], radius: 260, kind: 'green' }
      ];

      var state = {
        tripMode: 'individual',
        individualDestId: 1,
        showAllRays: true,
        routeFilter: 'completo',
        statusFilter: 'todos',
        categoryFilter: 'todas',
        searchQuery: '',
        returnToStart: true,
        selectedStopId: 1,
        activeModalStopId: 1,
        activeModalTab: 'sobre',
        activeMapsTab: 'individuais',
        mobileMode: 'split',
        showZones: true,
        nudgeIndex: 0,
        diaryTitle: '',
        completedIds: [],
        redeemedRewards: [],
        records: {}
      };

      var sessionPhotos = {};
      var map = null;
      var routeGroup = null;
      var zonesGroup = null;
      var markerMap = {};
      var sketchState = {
        inkKey: 'moon',
        width: 2.8,
        drawing: false,
        currentPoints: []
      };
      var toastTimer = null;

      function cssVar(name) {
        return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      }

      function getChallengeById(id) {
        return CHALLENGES.find(function (c) { return c.id === id; }) || CHALLENGES[0];
      }

      function getStopRecord(id) {
        var key = String(id);
        if (!state.records[key]) {
          state.records[key] = {
            details: [false, false, false, false],
            sensations: [],
            notes: '',
            strokes: []
          };
        }
        return state.records[key];
      }

      function hasRecordContent(id) {
        var rec = getStopRecord(id);
        var hasDetails = Array.isArray(rec.details) && rec.details.some(Boolean);
        var hasSens = Array.isArray(rec.sensations) && rec.sensations.length > 0;
        var hasNotes = typeof rec.notes === 'string' && rec.notes.trim().length > 0;
        var hasStrokes = Array.isArray(rec.strokes) && rec.strokes.length > 0;
        var hasPhoto = Boolean(sessionPhotos[String(id)]);
        return hasDetails || hasSens || hasNotes || hasStrokes || hasPhoto;
      }

      function isCompleted(id) {
        return state.completedIds.indexOf(id) !== -1;
      }

      function getLevelInfo(count) {
        if (count >= 12) return { level: 5, name: 'Rainha dos Passeios 👑' };
        if (count >= 9) return { level: 4, name: 'Guardiã de Viseu 🦋' };
        if (count >= 6) return { level: 3, name: 'Caçadora de Detalhes 🔮' };
        if (count >= 3) return { level: 2, name: 'Exploradora do Rossio ✨' };
        return { level: 1, name: 'Primeiros Passinhos 👟' };
      }

      function buildGoogleMapsWalkingUrl(originCoords, destCoords) {
        return 'https://www.google.com/maps/dir/?api=1&origin=' +
          originCoords[0].toFixed(5) + ',' + originCoords[1].toFixed(5) +
          '&destination=' + destCoords[0].toFixed(5) + ',' + destCoords[1].toFixed(5) +
          '&travelmode=walking';
      }

      function calculateWalkingDistanceKm(coordsA, coordsB) {
        var R = 6371;
        var toRad = function (deg) { return (deg * Math.PI) / 180; };
        var dLat = toRad(coordsB[0] - coordsA[0]);
        var dLon = toRad(coordsB[1] - coordsA[1]);
        var lat1 = toRad(coordsA[0]);
        var lat2 = toRad(coordsB[0]);
        var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
        var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        return R * c * PEDESTRIAN_FACTOR;
      }

      function calculateWalkingMinutes(distanceKm) {
        return (distanceKm / WALKING_SPEED_KMH) * 60;
      }

      function getEffortInfo(oneWayMinutes) {
        if (oneWayMinutes <= 12) return { label: '🌱 Passeio curtinho', cls: 'badge-nature' };
        if (oneWayMinutes <= 18) return { label: '💜 Passeio suave', cls: 'badge-lavender' };
        return { label: '✨ Boa caminhada', cls: 'badge-pink' };
      }

      function formatSegmentDist(km) {
        if (km < 1) {
          return Math.max(10, Math.round((km * 1000) / 10) * 10) + ' m';
        }
        return km.toFixed(2).replace('.', ',') + ' km';
      }

      function formatTotalDist(km) {
        return km.toFixed(2).replace('.', ',') + ' km';
      }

      function formatTotalTime(minutes) {
        var rounded = Math.max(1, Math.round(minutes));
        if (rounded < 60) return rounded + ' min';
        var h = Math.floor(rounded / 60);
        var m = rounded % 60;
        return m === 0 ? h + ' h' : h + 'h ' + (m < 10 ? '0' + m : m) + 'm';
      }

      function getGeoFilteredRouteStops() {
        var filtered = CHALLENGES.filter(function (c) {
          if (state.routeFilter === 'natureza') return c.categoriaMapa === 'natureza';
          if (state.routeFilter === 'patrimonio') return c.categoriaMapa === 'patrimonio';
          return true;
        });
        return [START_HUB].concat(filtered);
      }

      function getCardFilteredChallenges() {
        var q = state.searchQuery.trim().toLowerCase();
        return CHALLENGES.filter(function (c) {
          if (state.routeFilter === 'natureza' && c.categoriaMapa !== 'natureza') return false;
          if (state.routeFilter === 'patrimonio' && c.categoriaMapa !== 'patrimonio') return false;
          if (state.categoryFilter !== 'todas' && c.categoriaCaderno !== state.categoryFilter) return false;
          if (state.statusFilter === 'por-fazer' && isCompleted(c.id)) return false;
          if (state.statusFilter === 'concluidos' && !isCompleted(c.id)) return false;
          if (state.statusFilter === 'com-registo' && !hasRecordContent(c.id)) return false;
          if (q) {
            var hay = (c.nome + ' ' + c.morada + ' ' + c.medalha + ' ' + c.descricao + ' ' + c.categoriaCaderno).toLowerCase();
            if (hay.indexOf(q) === -1) return false;
          }
          return true;
        });
      }

      function applySavedState(saved) {
        if (!saved || typeof saved !== 'object') return;
        if (Array.isArray(saved.completedIds)) state.completedIds = saved.completedIds;
        if (Array.isArray(saved.redeemedRewards)) state.redeemedRewards = saved.redeemedRewards;
        if (saved.records && typeof saved.records === 'object') state.records = saved.records;
        if (typeof saved.diaryTitle === 'string') state.diaryTitle = saved.diaryTitle;
        if (typeof saved.returnToStart === 'boolean') state.returnToStart = saved.returnToStart;
        if (typeof saved.routeFilter === 'string') state.routeFilter = saved.routeFilter;
        if (saved.tripMode === 'individual' || saved.tripMode === 'sequencial') state.tripMode = saved.tripMode;
        if (typeof saved.individualDestId === 'number') state.individualDestId = saved.individualDestId;
      }

      async function loadPersistedState() {
        try {
          if (window.notebookAppApi && typeof window.notebookAppApi.getAppState === 'function') {
            var saved = await window.notebookAppApi.getAppState();
            if (saved) {
              applySavedState(saved);
              return;
            }
          }
        } catch (err) {
          console.warn('Aviso ao ler estado da API:', err);
        }
        try {
          var raw = window.localStorage.getItem(STORAGE_KEY);
          if (raw) applySavedState(JSON.parse(raw));
        } catch (err2) {
          console.warn('Aviso ao ler localStorage:', err2);
        }
      }

      async function savePersistedState() {
        var payload = {
          completedIds: state.completedIds,
          redeemedRewards: state.redeemedRewards,
          records: state.records,
          diaryTitle: state.diaryTitle,
          returnToStart: state.returnToStart,
          routeFilter: state.routeFilter,
          tripMode: state.tripMode,
          individualDestId: state.individualDestId
        };
        try {
          window.localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
        } catch (err) {
          console.warn('Aviso localStorage:', err);
        }
        try {
          if (window.notebookAppApi && typeof window.notebookAppApi.setAppState === 'function') {
            await window.notebookAppApi.setAppState(payload);
          }
        } catch (err2) {
          console.warn('Aviso API setAppState:', err2);
        }
      }

      function initMap() {
        var mapEl = document.getElementById('map');
        if (!mapEl || typeof window.L === 'undefined') return;

        map = L.map('map', {
          center: [40.6588, -7.9125],
          zoom: 15,
          minZoom: 13,
          maxZoom: 17,
          scrollWheelZoom: false,
          attributionControl: true
        });
        map.attributionControl.setPrefix('');
        map.attributionControl.addAttribution('Cartografia Esquemática · Viseu 💜');

        zonesGroup = L.layerGroup().addTo(map);
        routeGroup = L.layerGroup().addTo(map);
      }

      function renderMap() {
        if (!map || !routeGroup || !zonesGroup) return;

        zonesGroup.clearLayers();
        routeGroup.clearLayers();
        markerMap = {};

        var primaryColor = cssVar('--primary');
        var primaryHover = cssVar('--primary-hover');
        var secondaryColor = cssVar('--secondary');
        var tertiaryColor = cssVar('--tertiary');
        var patrimonyColor = cssVar('--patrimony');

        if (state.showZones) {
          ZONES.forEach(function (z) {
            var fill = z.kind === 'green' ? tertiaryColor : (z.kind === 'start' ? secondaryColor : primaryColor);
            L.circle(z.coords, {
              radius: z.radius,
              color: fill,
              weight: 1.2,
              opacity: 0.32,
              fillColor: fill,
              fillOpacity: 0.08,
              interactive: false
            }).addTo(zonesGroup);

            L.marker(z.coords, {
              interactive: false,
              icon: L.divIcon({
                className: '',
                html: '<div class="zone-label-icon">' + z.name + '</div>',
                iconSize: [160, 20],
                iconAnchor: [80, -20]
              })
            }).addTo(zonesGroup);
          });
        }

        var routeStops = getGeoFilteredRouteStops();

        if (state.tripMode === 'individual') {
          var activeDest = getChallengeById(state.individualDestId);

          if (state.showAllRays) {
            routeStops.forEach(function (s) {
              if (s.id === 0 || s.id === activeDest.id) return;
              L.polyline([START_HUB.coords, s.coords], {
                color: primaryHover,
                weight: 1.5,
                opacity: 0.24,
                dashArray: '4, 6',
                interactive: false
              }).addTo(routeGroup);
            });
          }

          L.polyline([START_HUB.coords, activeDest.coords], {
            color: primaryHover,
            weight: 9,
            opacity: 0.25,
            lineCap: 'round'
          }).addTo(routeGroup);

          L.polyline([START_HUB.coords, activeDest.coords], {
            color: primaryColor,
            weight: 4,
            opacity: 0.96,
            lineCap: 'round'
          }).addTo(routeGroup);

          if (state.returnToStart) {
            var midLat = (START_HUB.coords[0] + activeDest.coords[0]) / 2 + 0.00045;
            var midLng = (START_HUB.coords[1] + activeDest.coords[1]) / 2 - 0.00035;
            L.polyline([activeDest.coords, [midLat, midLng], START_HUB.coords], {
              color: secondaryColor,
              weight: 2.8,
              opacity: 0.9,
              dashArray: '6, 8',
              lineCap: 'round'
            }).addTo(routeGroup);
          }

          var allStopsForMap = [START_HUB].concat(CHALLENGES);
          allStopsForMap.forEach(function (stop, idx) {
            var done = stop.id !== 0 && isCompleted(stop.id);
            var isTarget = stop.id === activeDest.id;
            var isOrigin = stop.id === 0;
            var dimmed = !isTarget && !isOrigin;
            var label = done ? '✓' : (isOrigin ? '🏠' : stop.code);
            var catClass = 'cat-' + stop.categoriaMapa;

            var icon = L.divIcon({
              className: '',
              html: '<div class="viseu-marker ' + catClass +
                (done ? ' is-completed' : '') +
                (isTarget || isOrigin ? ' is-selected' : '') +
                (dimmed ? ' is-dimmed' : '') + '">' + label + '</div>',
              iconSize: [34, 34],
              iconAnchor: [17, 17],
              popupAnchor: [0, -18]
            });

            var directKm = stop.id === 0 ? 0 : calculateWalkingDistanceKm(START_HUB.coords, stop.coords);
            var directMin = Math.max(1, Math.round(calculateWalkingMinutes(directKm)));
            var segText = stop.id === 0
              ? 'Origem de todas as 12 saídas individuais'
              : 'Do Bairro: ' + formatSegmentDist(directKm) + ' (~' + directMin + ' min ida · ~' + (directMin * 2) + ' min ida e volta)';

            var gmapsUrl = stop.id === 0 ? '' : buildGoogleMapsWalkingUrl(START_HUB.coords, stop.coords);

            var popupHtml =
              '<div>' +
                '<div class="popup-header ' + catClass + '">' +
                  '<div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em; opacity:0.92;">' + stop.code + ' · ' + stop.categoriaCaderno + '</div>' +
                  '<div style="font-family:var(--font-headline); font-size:1.18rem; font-weight:600; line-height:1.15;">' + stop.nome + '</div>' +
                '</div>' +
                '<div class="popup-body">' +
                  '<div style="font-size:0.78rem; color:var(--on-primary-container); font-weight:600;">' + segText + '</div>' +
                  '<div style="font-size:0.82rem; color:var(--on-surface-variant);">' + stop.destaque + '</div>' +
                  (stop.id !== 0
                    ? '<div style="display:flex; flex-wrap:wrap; gap:0.4rem; padding-top:0.2rem;">' +
                        '<button type="button" class="btn btn-primary btn-sm" onclick="openStopModalFromMap(' + stop.id + ')">📓 Caderno</button>' +
                        '<a href="' + gmapsUrl + '" target="_blank" rel="noopener noreferrer" class="btn btn-pink btn-sm">🗺️ Google Maps</a>' +
                      '</div>'
                    : '') +
                '</div>' +
              '</div>';

            var marker = L.marker(stop.coords, {
              icon: icon,
              zIndexOffset: isTarget ? 900 : (isOrigin ? 800 : idx * 10)
            }).bindPopup(popupHtml, { maxWidth: 280 });

            marker.on('click', function () {
              if (stop.id !== 0) {
                selectIndividualDestination(stop.id, false);
              } else {
                selectStopOnMap(0, false);
              }
            });

            marker.addTo(routeGroup);
            markerMap[stop.id] = marker;
          });

        } else {
          var coords = routeStops.map(function (s) { return s.coords; });

          if (coords.length > 1) {
            L.polyline(coords, {
              color: primaryHover,
              weight: 8,
              opacity: 0.22,
              lineCap: 'round',
              lineJoin: 'round'
            }).addTo(routeGroup);

            var routeStroke = state.routeFilter === 'natureza' ? tertiaryColor
                            : (state.routeFilter === 'patrimonio' ? patrimonyColor : primaryColor);
            L.polyline(coords, {
              color: routeStroke,
              weight: 3.8,
              opacity: 0.94,
              lineCap: 'round',
              lineJoin: 'round'
            }).addTo(routeGroup);
          }

          if (state.returnToStart && coords.length > 1) {
            L.polyline([coords[coords.length - 1], coords[0]], {
              color: secondaryColor,
              weight: 3,
              opacity: 0.9,
              dashArray: '7, 8',
              lineCap: 'round'
            }).addTo(routeGroup);
          }

          routeStops.forEach(function (stop, idx) {
            var done = stop.id !== 0 && isCompleted(stop.id);
            var selected = state.selectedStopId === stop.id;
            var label = done ? '✓' : (stop.id === 0 ? '🏠' : stop.code);
            var catClass = 'cat-' + stop.categoriaMapa;

            var icon = L.divIcon({
              className: '',
              html: '<div class="viseu-marker ' + catClass + (done ? ' is-completed' : '') + (selected ? ' is-selected' : '') + '">' + label + '</div>',
              iconSize: [34, 34],
              iconAnchor: [17, 17],
              popupAnchor: [0, -18]
            });

            var prev = idx > 0 ? routeStops[idx - 1] : null;
            var segText = prev
              ? formatSegmentDist(calculateWalkingDistanceKm(prev.coords, stop.coords)) + ' · ~' + Math.round(calculateWalkingMinutes(calculateWalkingDistanceKm(prev.coords, stop.coords))) + ' min da paragem anterior'
              : 'Ponto de partida do roteiro circular';

            var popupHtml =
              '<div>' +
                '<div class="popup-header ' + catClass + '">' +
                  '<div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em; opacity:0.92;">' + stop.code + ' · ' + stop.categoriaCaderno + '</div>' +
                  '<div style="font-family:var(--font-headline); font-size:1.18rem; font-weight:600; line-height:1.15;">' + stop.nome + '</div>' +
                '</div>' +
                '<div class="popup-body">' +
                  '<div style="font-size:0.78rem; color:var(--on-primary-container);">' + segText + '</div>' +
                  '<div style="font-size:0.82rem; color:var(--on-surface-variant);">' + stop.destaque + '</div>' +
                  (stop.id !== 0
                    ? '<div style="display:flex; flex-wrap:wrap; gap:0.4rem; padding-top:0.2rem;">' +
                        '<button type="button" class="btn btn-primary btn-sm" onclick="openStopModalFromMap(' + stop.id + ')">📓 Abrir Caderno</button>' +
                        '<button type="button" class="btn btn-secondary btn-sm" onclick="switchToIndividualForStop(' + stop.id + ')">🎯 Só do Bairro</button>' +
                      '</div>'
                    : '') +
                '</div>' +
              '</div>';

            var marker = L.marker(stop.coords, {
              icon: icon,
              zIndexOffset: selected ? 600 : idx * 10
            }).bindPopup(popupHtml, { maxWidth: 280 });

            marker.on('click', function () {
              selectStopOnMap(stop.id, false);
            });

            marker.addTo(routeGroup);
            markerMap[stop.id] = marker;
          });
        }
      }

      function fitMapBounds() {
        if (!map) return;
        if (state.tripMode === 'individual') {
          var dest = getChallengeById(state.individualDestId);
          var boundsInd = L.latLngBounds([START_HUB.coords, dest.coords]);
          map.fitBounds(boundsInd, { padding: [55, 55], maxZoom: 16 });
        } else {
          var routeStops = getGeoFilteredRouteStops();
          if (routeStops.length === 0) return;
          var bounds = L.latLngBounds(routeStops.map(function (s) { return s.coords; }));
          map.fitBounds(bounds, { padding: [38, 38], maxZoom: 16 });
        }
      }

      function selectIndividualDestination(id, fitAndOpenPopup) {
        var stop = getChallengeById(id);
        state.individualDestId = stop.id;
        state.selectedStopId = stop.id;
        savePersistedState();
        renderAll(Boolean(fitAndOpenPopup));
        var marker = markerMap[stop.id];
        if (map && marker && fitAndOpenPopup) {
          setTimeout(function () { marker.openPopup(); }, 220);
        }
      }

      function switchToIndividualForStop(id) {
        state.tripMode = 'individual';
        state.individualDestId = id;
        state.selectedStopId = id;
        savePersistedState();
        renderAll(true);
        var stop = getChallengeById(id);
        showToast('🎯 Percurso individual: Bairro 1º de Maio → ' + stop.nome);
      }

      function selectStopOnMap(id, openPopup) {
        state.selectedStopId = id;
        if (state.tripMode === 'individual' && id !== 0) {
          state.individualDestId = id;
          savePersistedState();
        }
        renderAll(false);
        var marker = markerMap[id];
        if (map && marker) {
          map.panTo(marker.getLatLng(), { animate: true });
          if (openPopup) marker.openPopup();
        }
        var card = document.getElementById('stop-card-' + id);
        if (card) {
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }

      function renderAll(shouldFit) {
        renderModeSwitcherAndSpotlight();
        renderHeaderAndMetrics();
        renderFilterChips();
        renderReturnToggle();
        renderItineraryList();
        renderMap();
        if (shouldFit) fitMapBounds();
      }

      function renderModeSwitcherAndSpotlight() {
        var isInd = state.tripMode === 'individual';
        document.querySelectorAll('[data-trip-mode]').forEach(function (btn) {
          var active = btn.getAttribute('data-trip-mode') === state.tripMode;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-selected', String(active));
        });

        var raysBtn = document.getElementById('toggleRaysBtn');
        if (raysBtn) {
          raysBtn.style.display = isInd ? 'inline-flex' : 'none';
          raysBtn.textContent = state.showAllRays ? 'Raios: Ativos' : 'Raios: Ocultos';
        }

        var spotlight = document.getElementById('individualSpotlight');
        if (spotlight) spotlight.classList.toggle('is-hidden', !isInd);

        if (isInd) {
          var dest = getChallengeById(state.individualDestId);
          var oneWayKm = calculateWalkingDistanceKm(START_HUB.coords, dest.coords);
          var oneWayMin = Math.max(1, Math.round(calculateWalkingMinutes(oneWayKm)));
          var roundKm = oneWayKm * 2;
          var roundMin = Math.max(2, Math.round(calculateWalkingMinutes(roundKm)));
          var effort = getEffortInfo(oneWayMin);

          var titleEl = document.getElementById('spotlightTitle');
          var effortEl = document.getElementById('spotlightEffortBadge');
          var oneWayEl = document.getElementById('spotlightOneWay');
          var roundEl = document.getElementById('spotlightRoundTrip');
          var medalEl = document.getElementById('spotlightMedal');
          var gmapsLink = document.getElementById('spotlightGmapsLink');

          if (titleEl) titleEl.textContent = 'Bairro 1º de Maio → ' + dest.nome;
          if (effortEl) {
            effortEl.className = 'badge ' + effort.cls;
            effortEl.textContent = effort.label;
          }
          if (oneWayEl) oneWayEl.textContent = formatSegmentDist(oneWayKm) + ' · ~' + oneWayMin + ' min';
          if (roundEl) roundEl.textContent = formatTotalDist(roundKm) + ' · ~' + formatTotalTime(roundMin);
          if (medalEl) medalEl.textContent = (isCompleted(dest.id) ? '🏅 ' : '🔒 ') + dest.medalha;
          if (gmapsLink) gmapsLink.href = buildGoogleMapsWalkingUrl(START_HUB.coords, dest.coords);

          var strip = document.getElementById('quickDestStrip');
          if (strip) {
            strip.innerHTML = CHALLENGES.map(function (c) {
              var sel = c.id === dest.id;
              var done = isCompleted(c.id);
              var km = calculateWalkingDistanceKm(START_HUB.coords, c.coords);
              var mins = Math.max(1, Math.round(calculateWalkingMinutes(km)));
              return '<button type="button" class="dest-pill' + (sel ? ' is-selected' : '') + (done ? ' is-done' : '') + '" onclick="selectIndividualDestination(' + c.id + ', true)">' +
                '<span>' + (done ? '✓' : c.code) + '</span>' +
                '<span>' + c.nome.split(' (')[0].split(' e ')[0] + '</span>' +
                '<span style="opacity:0.75; font-family:var(--font-mono); font-size:0.7rem;">' + mins + 'm</span>' +
              '</button>';
            }).join('');
          }
        }
      }

      function renderHeaderAndMetrics() {
        var doneCount = state.completedIds.length;
        var lvl = getLevelInfo(doneCount);
        var pct = Math.round((doneCount / CHALLENGES.length) * 100);

        var levelLabel = document.getElementById('levelLabel');
        var levelCount = document.getElementById('levelCount');
        if (levelLabel) levelLabel.textContent = 'Nv. ' + lvl.level + ' · ' + lvl.name;
        if (levelCount) levelCount.textContent = doneCount + '/12';

        var mStopsLabel = document.getElementById('metricStopsLabel');
        var mStops = document.getElementById('metricStops');
        var mStopsSub = document.getElementById('metricStopsSub');
        var mDist = document.getElementById('metricDistance');
        var mDistSub = document.getElementById('metricDistSub');
        var mTime = document.getElementById('metricTime');
        var mChal = document.getElementById('metricChallenges');
        var mAwardsSub = document.getElementById('metricAwardsSub');
        var fill = document.getElementById('progressFill');
        var summary = document.getElementById('mapRouteSummary');
        var scaleLabel = document.getElementById('mapScaleLabel');

        if (state.tripMode === 'individual') {
          var dest = getChallengeById(state.individualDestId);
          var oneWayKm = calculateWalkingDistanceKm(START_HUB.coords, dest.coords);
          var totalKm = state.returnToStart ? oneWayKm * 2 : oneWayKm;
          var totalMin = calculateWalkingMinutes(totalKm);

          if (mStopsLabel) mStopsLabel.textContent = 'Destino Individual';
          if (mStops) mStops.textContent = '#' + dest.code;
          if (mStopsSub) mStopsSub.textContent = dest.nome.length > 26 ? dest.nome.slice(0, 25) + '…' : dest.nome;
          if (mDist) mDist.textContent = formatTotalDist(totalKm);
          if (mDistSub) mDistSub.textContent = state.returnToStart ? 'Ida e volta ao Bairro' : 'Só ida desde o Bairro';
          if (mTime) mTime.textContent = formatTotalTime(totalMin);
          if (summary) summary.textContent = 'Bairro 1º de Maio ' + (state.returnToStart ? '↔ ' : '→ ') + dest.nome + ' · ' + formatTotalDist(totalKm);
          if (scaleLabel) scaleLabel.textContent = 'Bairro → ' + dest.nome.split(' (')[0] + ' (' + formatSegmentDist(oneWayKm) + ' ida)';
        } else {
          var routeStops = getGeoFilteredRouteStops();
          var seqKm = 0;
          for (var i = 0; i < routeStops.length - 1; i++) {
            seqKm += calculateWalkingDistanceKm(routeStops[i].coords, routeStops[i + 1].coords);
          }
          if (state.returnToStart && routeStops.length > 1) {
            seqKm += calculateWalkingDistanceKm(routeStops[routeStops.length - 1].coords, routeStops[0].coords);
          }
          var seqMin = calculateWalkingMinutes(seqKm);

          if (mStopsLabel) mStopsLabel.textContent = 'Paragens Ativas';
          if (mStops) mStops.textContent = String(routeStops.length);
          if (mStopsSub) mStopsSub.textContent = state.returnToStart ? 'Partida + ' + (routeStops.length - 1) + ' paragens (circular)' : 'Percurso de ida';
          if (mDist) mDist.textContent = formatTotalDist(seqKm);
          if (mDistSub) mDistSub.textContent = 'Haversine × 1,25 (urbano)';
          if (mTime) mTime.textContent = formatTotalTime(seqMin);
          if (summary) summary.textContent = (state.returnToStart ? 'Roteiro circular' : 'Roteiro de ida') + ' · ' + formatTotalDist(seqKm) + ' (~' + formatTotalTime(seqMin) + ')';
          if (scaleLabel) scaleLabel.textContent = 'Escala real · Bairro 1º de Maio → Fontelo (~1,6 km)';
        }

        if (mChal) mChal.textContent = doneCount + '/12';
        if (mAwardsSub) mAwardsSub.textContent = doneCount + ' medalhas · ' + state.redeemedRewards.length + ' mimos';
        if (fill) fill.style.width = pct + '%';

        var nudgeEl = document.getElementById('nudgeQuote');
        if (nudgeEl) nudgeEl.textContent = '«' + NUDGES[state.nudgeIndex % NUDGES.length] + '»';
      }

      function renderFilterChips() {
        document.querySelectorAll('[data-route-filter]').forEach(function (btn) {
          var f = btn.getAttribute('data-route-filter');
          btn.classList.remove('is-active', 'is-active-nature', 'is-active-heritage');
          if (f === state.routeFilter) {
            if (f === 'natureza') btn.classList.add('is-active-nature');
            else if (f === 'patrimonio') btn.classList.add('is-active-heritage');
            else btn.classList.add('is-active');
          }
        });

        document.querySelectorAll('[data-status-filter]').forEach(function (btn) {
          btn.classList.toggle('is-active', btn.getAttribute('data-status-filter') === state.statusFilter);
        });

        document.querySelectorAll('[data-cat-filter]').forEach(function (btn) {
          btn.classList.toggle('is-active', btn.getAttribute('data-cat-filter') === state.categoryFilter);
        });
      }

      function renderReturnToggle() {
        var btn = document.getElementById('returnToggle');
        var sub = document.getElementById('returnSub');
        var title = document.getElementById('returnToggleTitle');
        var leg = document.getElementById('legendReturn');
        if (btn) btn.setAttribute('aria-checked', String(state.returnToStart));
        if (leg) leg.style.display = state.returnToStart ? 'inline-flex' : 'none';

        if (state.tripMode === 'individual') {
          var dest = getChallengeById(state.individualDestId);
          var oneWayKm = calculateWalkingDistanceKm(START_HUB.coords, dest.coords);
          var oneWayMin = Math.max(1, Math.round(calculateWalkingMinutes(oneWayKm)));
          if (title) title.textContent = 'Calcular ida e volta ao Bairro 1º de Maio';
          if (sub) {
            sub.textContent = state.returnToStart
              ? 'Ida e volta incluída (+' + formatSegmentDist(oneWayKm) + ' · ~' + oneWayMin + ' min de regresso)'
              : 'Mostra apenas a distância de ida até ao destino';
          }
        } else {
          var routeStops = getGeoFilteredRouteStops();
          if (title) title.textContent = 'Regresso circular ao Bairro 1º de Maio';
          if (sub && routeStops.length > 1) {
            var retKm = calculateWalkingDistanceKm(routeStops[routeStops.length - 1].coords, routeStops[0].coords);
            var retMin = Math.round(calculateWalkingMinutes(retKm));
            sub.textContent = state.returnToStart
              ? 'Regresso incluído (+' + formatSegmentDist(retKm) + ' · ~' + retMin + ' min)'
              : 'Termina na última paragem selecionada';
          }
        }
      }

      function renderItineraryList() {
        var container = document.getElementById('itineraryList');
        if (!container) return;

        var visibleChallenges = getCardFilteredChallenges();
        var isInd = state.tripMode === 'individual';
        container.classList.toggle('is-individual-grid', isInd);

        var htmlParts = [];

        if (!isInd) {
          htmlParts.push(
            '<article id="stop-card-0" class="stop-card is-start-hub' + (state.selectedStopId === 0 ? ' is-selected' : '') + '" onclick="handleCardClick(0)">' +
              '<div class="stop-head">' +
                '<div class="stop-num-badge cat-partida">🏠</div>' +
                '<div class="stop-title-wrap">' +
                  '<div class="badge-row"><span class="badge badge-pink">Origem · Partida &amp; Chegada</span></div>' +
                  '<h2 class="stop-title">' + START_HUB.nome + '</h2>' +
                  '<div class="stop-meta">' + START_HUB.morada + '</div>' +
                '</div>' +
                '<button type="button" class="btn btn-secondary btn-sm" onclick="event.stopPropagation(); focusStopFromCard(0)">Ver no mapa</button>' +
              '</div>' +
              '<p class="stop-desc">' + START_HUB.descricao + '</p>' +
            '</article>'
          );
        }

        if (visibleChallenges.length === 0) {
          htmlParts.push(
            '<div class="empty-state" style="margin-top:var(--space-md);">' +
              '<h3 class="modal-title">Nenhuma paragem encontrada 🔮</h3>' +
              '<p class="stop-desc">Ajusta a pesquisa ou limpa os filtros para voltar a ver os 12 destinos de Viseu.</p>' +
              '<button type="button" class="btn btn-primary" onclick="clearAllFilters()">Mostrar todas as paragens</button>' +
            '</div>'
          );
          container.innerHTML = htmlParts.join('');
          return;
        }

        visibleChallenges.forEach(function (stop, idx) {
          var done = isCompleted(stop.id);
          var rec = getStopRecord(stop.id);
          var detDone = rec.details.filter(Boolean).length;
          var catBadgeClass = stop.categoriaMapa === 'natureza' ? 'badge-nature' : 'badge-heritage';

          var directKm = calculateWalkingDistanceKm(START_HUB.coords, stop.coords);
          var directMin = Math.max(1, Math.round(calculateWalkingMinutes(directKm)));
          var effort = getEffortInfo(directMin);
          var gmapsDirectUrl = buildGoogleMapsWalkingUrl(START_HUB.coords, stop.coords);

          if (!isInd) {
            var prevStop = idx === 0 ? START_HUB : visibleChallenges[idx - 1];
            var segKm = calculateWalkingDistanceKm(prevStop.coords, stop.coords);
            var segMin = Math.max(1, Math.round(calculateWalkingMinutes(segKm)));
            htmlParts.push(
              '<div class="segment-connector">' +
                '<span class="segment-pill">🚶 ' + formatSegmentDist(segKm) + ' · ~' + segMin + ' min a pé</span>' +
              '</div>'
            );
          }

          var isActiveCard = isInd ? (state.individualDestId === stop.id) : (state.selectedStopId === stop.id);

          htmlParts.push(
            '<article id="stop-card-' + stop.id + '" class="stop-card' + (done ? ' is-completed' : '') + (isActiveCard ? ' is-selected' : '') + '" onclick="handleCardClick(' + stop.id + ')">' +
              '<div class="stop-head">' +
                '<div class="stop-num-badge cat-' + stop.categoriaMapa + (done ? ' is-done' : '') + '">' + (done ? '✓' : stop.code) + '</div>' +
                '<div class="stop-title-wrap">' +
                  '<div class="badge-row">' +
                    '<span class="badge ' + catBadgeClass + '">' + (stop.categoriaMapa === 'natureza' ? '🌿 Natureza' : '🏛️ Património') + '</span>' +
                    '<span class="badge ' + effort.cls + '">' + effort.label + '</span>' +
                    (isInd && isActiveCard ? '<span class="badge badge-pink">✨ Rota ativa no mapa</span>' : '') +
                  '</div>' +
                  '<h2 class="stop-title">' + stop.nome + '</h2>' +
                  '<div class="stop-meta">' + stop.epoca + ' · ' + stop.morada + '</div>' +
                '</div>' +
              '</div>' +
              '<p class="stop-desc">' + stop.descricao + '</p>' +
              '<div class="direct-trip-strip">' +
                '<span>🏠 <strong>Do Bairro 1º de Maio:</strong> ' + formatSegmentDist(directKm) + ' (~' + directMin + ' min ida · ~' + (directMin * 2) + ' min ida e volta)</span>' +
                '<a href="' + gmapsDirectUrl + '" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation();" style="color:#f9a8d4; font-weight:700; text-decoration:none;">Google Maps ↗</a>' +
              '</div>' +
              '<div class="stop-footer">' +
                '<div class="medal-pill' + (done ? ' is-unlocked' : '') + '">' +
                  '<span>' + (done ? '🏅 ' + stop.medalha : '🔒 ' + stop.medalha) + '</span>' +
                  '<span>· ' + detDone + '/4 detalhes</span>' +
                '</div>' +
                '<div class="stop-actions">' +
                  (isInd
                    ? '<button type="button" class="btn ' + (isActiveCard ? 'btn-pink' : 'btn-secondary') + ' btn-sm" onclick="event.stopPropagation(); focusIndividualFromCard(' + stop.id + ')">' + (isActiveCard ? '🎯 Rota traçada' : '🎯 Traçar do Bairro') + '</button>'
                    : '<button type="button" class="btn btn-ghost btn-sm" onclick="event.stopPropagation(); switchToIndividualForStop(' + stop.id + ')">🎯 Só do Bairro</button>') +
                  '<button type="button" class="btn ' + (done ? 'btn-emerald' : 'btn-primary') + ' btn-sm" onclick="event.stopPropagation(); openStopModal(' + stop.id + ')">Abrir Caderno →</button>' +
                '</div>' +
              '</div>' +
            '</article>'
          );
        });

        var routeStops = getGeoFilteredRouteStops();
        if (!isInd && state.returnToStart && routeStops.length > 1) {
          var lastStop = visibleChallenges[visibleChallenges.length - 1];
          var retKm = calculateWalkingDistanceKm(lastStop.coords, START_HUB.coords);
          var retMin = Math.max(1, Math.round(calculateWalkingMinutes(retKm)));
          htmlParts.push(
            '<div class="segment-connector is-return">' +
              '<span class="segment-pill">↺ ' + formatSegmentDist(retKm) + ' · ~' + retMin + ' min de regresso</span>' +
            '</div>' +
            '<div class="stop-card is-start-hub">' +
              '<div class="stop-head">' +
                '<div class="stop-num-badge cat-partida">↺</div>' +
                '<div class="stop-title-wrap">' +
                  '<div class="badge-row"><span class="badge badge-pink">Chegada Circular</span></div>' +
                  '<h2 class="stop-title">Regresso ao Bairro 1º de Maio</h2>' +
                  '<div class="stop-meta">Caminhada de retorno desde ' + lastStop.nome + '</div>' +
                '</div>' +
              '</div>' +
            '</div>'
          );
        }

        container.innerHTML = htmlParts.join('');
      }

      function handleCardClick(id) {
        if (state.tripMode === 'individual' && id !== 0) {
          selectIndividualDestination(id, true);
        } else {
          selectStopOnMap(id, true);
        }
      }

      function focusStopFromCard(id) {
        if (window.innerWidth <= 960 && state.mobileMode === 'list') {
          setMobileMode('split');
        }
        selectStopOnMap(id, true);
      }

      function focusIndividualFromCard(id) {
        if (window.innerWidth <= 960 && state.mobileMode === 'list') {
          setMobileMode('split');
        }
        selectIndividualDestination(id, true);
        var stop = getChallengeById(id);
        showToast('🎯 Rota traçada: Bairro 1º de Maio → ' + stop.nome);
      }

      function openStopModalFromMap(id) {
        openStopModal(id);
      }

      function clearAllFilters() {
        state.routeFilter = 'completo';
        state.statusFilter = 'todos';
        state.categoryFilter = 'todas';
        state.searchQuery = '';
        var inp = document.getElementById('searchInput');
        if (inp) inp.value = '';
        renderAll(true);
      }

      function openStopModal(id) {
        var stop = CHALLENGES.find(function (c) { return c.id === id; });
        if (!stop) return;
        state.activeModalStopId = id;
        state.selectedStopId = id;
        renderStopModalContent();
        var modal = document.getElementById('stopModal');
        if (modal) modal.classList.remove('is-hidden');
        renderSketchCanvas();
      }

      function closeStopModal() {
        var modal = document.getElementById('stopModal');
        if (modal) modal.classList.add('is-hidden');
      }

      function switchStopModalTab(tabName) {
        state.activeModalTab = tabName;
        document.querySelectorAll('[data-stop-tab]').forEach(function (btn) {
          var active = btn.getAttribute('data-stop-tab') === tabName;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-selected', String(active));
        });
        var pSobre = document.getElementById('tabPanelSobre');
        var pDesafio = document.getElementById('tabPanelDesafio');
        var pRegisto = document.getElementById('tabPanelRegisto');
        if (pSobre) pSobre.style.display = tabName === 'sobre' ? 'grid' : 'none';
        if (pDesafio) pDesafio.style.display = tabName === 'desafio' ? 'grid' : 'none';
        if (pRegisto) pRegisto.style.display = tabName === 'registo' ? 'grid' : 'none';

        if (tabName === 'registo') {
          setTimeout(renderSketchCanvas, 40);
        }
      }

      function renderStopModalContent() {
        var stop = CHALLENGES.find(function (c) { return c.id === state.activeModalStopId; });
        if (!stop) return;
        var done = isCompleted(stop.id);
        var rec = getStopRecord(stop.id);

        var directKm = calculateWalkingDistanceKm(START_HUB.coords, stop.coords);
        var directMin = Math.max(1, Math.round(calculateWalkingMinutes(directKm)));
        var roundKm = directKm * 2;
        var roundMin = Math.max(2, Math.round(calculateWalkingMinutes(roundKm)));

        var kicker = document.getElementById('stopModalKicker');
        var title = document.getElementById('stopModalTitle');
        var desc = document.getElementById('modalDescription');
        var badges = document.getElementById('modalMetaBadges');
        var fromBairro = document.getElementById('modalFromBairroInfo');
        var gmapsBtn = document.getElementById('modalGmapsWalkBtn');
        var addr = document.getElementById('modalAddress');
        var sched = document.getElementById('modalSchedule');
        var coordsEl = document.getElementById('modalCoordsText');
        var medalStatus = document.getElementById('modalMedalStatus');
        var medalName = document.getElementById('modalMedalName');
        var rewardText = document.getElementById('modalRewardText');
        var prompt = document.getElementById('modalChallengePrompt');
        var completeBtn = document.getElementById('completeChallengeBtn');
        var hint = document.getElementById('modalCompletionHint');

        if (kicker) kicker.textContent = stop.code + ' · ' + stop.categoriaCaderno;
        if (title) title.textContent = stop.nome;
        if (desc) desc.textContent = stop.descricao;
        if (badges) {
          badges.innerHTML =
            '<span class="badge ' + (stop.categoriaMapa === 'natureza' ? 'badge-nature' : 'badge-heritage') + '">' + stop.fonte + '</span>' +
            '<span class="badge badge-lavender">' + stop.epoca + '</span>' +
            '<span class="badge ' + (done ? 'badge-nature' : 'badge-pink') + '">' + (done ? '✓ Concluído' : 'Por fazer') + '</span>';
        }
        if (fromBairro) {
          fromBairro.textContent = formatSegmentDist(directKm) + ' (~' + directMin + ' min só ida) · ' + formatTotalDist(roundKm) + ' (~' + formatTotalTime(roundMin) + ' ida e volta)';
        }
        if (gmapsBtn) gmapsBtn.href = buildGoogleMapsWalkingUrl(START_HUB.coords, stop.coords);

        if (addr) addr.textContent = stop.morada;
        if (sched) sched.textContent = stop.horario;
        if (coordsEl) coordsEl.textContent = stop.coords[0].toFixed(5) + ', ' + stop.coords[1].toFixed(5);
        if (medalStatus) medalStatus.textContent = done ? '🏅 Medalha desbloqueada!' : '🔒 Medalha a desbloquear';
        if (medalName) medalName.textContent = stop.medalha;
        if (rewardText) rewardText.textContent = '🎁 Mimo Merecido: ' + stop.premio;
        if (prompt) prompt.textContent = '«' + stop.miniDesafio + '»';

        if (completeBtn) {
          completeBtn.textContent = done ? 'Desafio concluído ✓ (Desmarcar)' : 'Concluir desafio ✓';
          completeBtn.className = 'btn ' + (done ? 'btn-secondary' : 'btn-emerald');
        }
        if (hint) {
          hint.textContent = done ? 'Conquistaste esta medalha no teu caderno! 💜' : 'Conclui o desafio para desbloquear a medalha e o mimo.';
        }

        var idx = CHALLENGES.findIndex(function (c) { return c.id === stop.id; });
        var prevBtn = document.getElementById('prevStopBtn');
        var nextBtn = document.getElementById('nextStopBtn');
        if (prevBtn) prevBtn.disabled = idx <= 0;
        if (nextBtn) nextBtn.disabled = idx >= CHALLENGES.length - 1;

        var detList = document.getElementById('modalDetailsList');
        var detCount = document.getElementById('modalDetailsCount');
        var checkedCount = rec.details.filter(Boolean).length;
        if (detCount) detCount.textContent = checkedCount + '/4 descobertos';
        if (detList) {
          detList.innerHTML = stop.detalhes.map(function (txt, i) {
            var isChk = Boolean(rec.details[i]);
            return '<button type="button" class="detail-item' + (isChk ? ' is-checked' : '') + '" onclick="toggleDetailItem(' + i + ')">' +
              '<span class="check-box">' + (isChk ? '✓' : '') + '</span>' +
              '<span>' + txt + '</span>' +
            '</button>';
          }).join('');
        }

        var sensGrid = document.getElementById('sensationsGrid');
        var sensCount = document.getElementById('sensationsCount');
        if (sensCount) sensCount.textContent = rec.sensations.length + ' selecionadas';
        if (sensGrid) {
          sensGrid.innerHTML = SENSATION_OPTIONS.map(function (label) {
            var active = rec.sensations.indexOf(label) !== -1;
            return '<button type="button" class="chip-btn' + (active ? ' is-active' : '') + '" onclick="toggleSensation(\'' + label.replace(/'/g, "\\'") + '\')">' + label + '</button>';
          }).join('');
        }

        var notesEl = document.getElementById('notesTextarea');
        if (notesEl) notesEl.value = rec.notes || '';

        var photoWrap = document.getElementById('photoPreviewWrap');
        var photoImg = document.getElementById('photoPreviewImg');
        var photoLbl = document.getElementById('photoMetaLabel');
        var photoInput = document.getElementById('photoInput');
        if (photoInput) photoInput.value = '';
        var sessionPhoto = sessionPhotos[String(stop.id)];
        if (photoWrap && photoImg && photoLbl) {
          if (sessionPhoto) {
            photoImg.src = sessionPhoto.url;
            photoLbl.textContent = sessionPhoto.name;
            photoWrap.style.display = 'grid';
          } else {
            photoImg.src = '';
            photoWrap.style.display = 'none';
          }
        }
      }

      function toggleDetailItem(index) {
        var rec = getStopRecord(state.activeModalStopId);
        rec.details[index] = !rec.details[index];
        savePersistedState();
        renderStopModalContent();
        renderItineraryList();
      }

      function toggleSensation(label) {
        var rec = getStopRecord(state.activeModalStopId);
        var idx = rec.sensations.indexOf(label);
        if (idx === -1) rec.sensations.push(label);
        else rec.sensations.splice(idx, 1);
        savePersistedState();
        renderStopModalContent();
      }

      function toggleCurrentChallengeCompletion() {
        var id = state.activeModalStopId;
        var stop = CHALLENGES.find(function (c) { return c.id === id; });
        if (!stop) return;
        var idx = state.completedIds.indexOf(id);
        if (idx === -1) {
          state.completedIds.push(id);
          savePersistedState();
          renderAll(false);
          renderStopModalContent();
          openCelebrationModal(stop);
        } else {
          state.completedIds.splice(idx, 1);
          savePersistedState();
          renderAll(false);
          renderStopModalContent();
          showToast('Desafio "' + stop.nome + '" desmarcado.');
        }
      }

      function spawnConfetti() {
        var box = document.getElementById('celebrationBox');
        if (!box) return;
        box.querySelectorAll('.confetti-piece').forEach(function (el) { el.remove(); });
        var colors = ['#c084fc', '#f472b6', '#34d399', '#fbbf24', '#a855f7', '#e9d5ff'];
        for (var i = 0; i < 28; i++) {
          var piece = document.createElement('span');
          piece.className = 'confetti-piece';
          piece.style.left = Math.random() * 100 + '%';
          piece.style.backgroundColor = colors[i % colors.length];
          piece.style.animationDelay = (Math.random() * 0.55).toFixed(2) + 's';
          piece.style.width = (7 + Math.random() * 6) + 'px';
          piece.style.height = (7 + Math.random() * 6) + 'px';
          box.appendChild(piece);
        }
      }

      function openCelebrationModal(stop) {
        var celModal = document.getElementById('celebrationModal');
        var celMedal = document.getElementById('celebrationMedalName');
        var celReward = document.getElementById('celebrationReward');
        if (celMedal) celMedal.textContent = '🏅 Medalha: ' + stop.medalha;
        if (celReward) celReward.textContent = '🎁 Mimo Merecido: ' + stop.premio;
        if (celModal) {
          celModal.classList.remove('is-hidden');
          spawnConfetti();
        }
      }

      function getInkHex(key) {
        if (key === 'purple') return '#c084fc';
        if (key === 'pink') return '#f472b6';
        if (key === 'mint') return '#34d399';
        if (key === 'gold') return '#fbbf24';
        if (key === 'terracotta') return '#f472b6';
        if (key === 'emerald') return '#34d399';
        if (key === 'brass') return '#fbbf24';
        return '#f5efff';
      }

      function renderSketchCanvas() {
        var canvas = document.getElementById('sketchCanvas');
        if (!canvas) return;
        var rect = canvas.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
          canvas.width = Math.round(rect.width);
          canvas.height = Math.round(rect.height);
        }
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        var rec = getStopRecord(state.activeModalStopId);
        if (!rec.strokes || rec.strokes.length === 0) {
          ctx.fillStyle = 'rgba(194, 179, 220, 0.55)';
          ctx.font = '14px Plus Jakarta Sans, sans-serif';
          ctx.fillText('✨ Esboça aqui um pequeno detalhe deste lugar…', 18, 34);
          return;
        }

        rec.strokes.forEach(function (stroke) {
          if (!stroke.points || stroke.points.length === 0) return;
          ctx.beginPath();
          ctx.strokeStyle = getInkHex(stroke.ink);
          ctx.lineWidth = stroke.width || 2.8;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.moveTo(stroke.points[0][0] * canvas.width, stroke.points[0][1] * canvas.height);
          for (var i = 1; i < stroke.points.length; i++) {
            ctx.lineTo(stroke.points[i][0] * canvas.width, stroke.points[i][1] * canvas.height);
          }
          ctx.stroke();
        });
      }

      function initSketchPadEvents() {
        var canvas = document.getElementById('sketchCanvas');
        if (!canvas) return;

        function getRelPoint(e) {
          var rect = canvas.getBoundingClientRect();
          return [
            Math.max(0, Math.min(1, (e.clientX - rect.left) / (rect.width || 1))),
            Math.max(0, Math.min(1, (e.clientY - rect.top) / (rect.height || 1)))
          ];
        }

        canvas.addEventListener('pointerdown', function (e) {
          canvas.setPointerCapture(e.pointerId);
          sketchState.drawing = true;
          sketchState.currentPoints = [getRelPoint(e)];
        });

        canvas.addEventListener('pointermove', function (e) {
          if (!sketchState.drawing) return;
          sketchState.currentPoints.push(getRelPoint(e));
          var ctx = canvas.getContext('2d');
          if (!ctx) return;
          renderSketchCanvas();
          var pts = sketchState.currentPoints;
          ctx.beginPath();
          ctx.strokeStyle = getInkHex(sketchState.inkKey);
          ctx.lineWidth = sketchState.width;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.moveTo(pts[0][0] * canvas.width, pts[0][1] * canvas.height);
          for (var i = 1; i < pts.length; i++) {
            ctx.lineTo(pts[i][0] * canvas.width, pts[i][1] * canvas.height);
          }
          ctx.stroke();
        });

        function finishStroke() {
          if (!sketchState.drawing) return;
          sketchState.drawing = false;
          if (sketchState.currentPoints.length > 1) {
            var rec = getStopRecord(state.activeModalStopId);
            rec.strokes.push({
              ink: sketchState.inkKey,
              width: sketchState.width,
              points: sketchState.currentPoints.map(function (p) {
                return [Number(p[0].toFixed(3)), Number(p[1].toFixed(3))];
              })
            });
            savePersistedState();
          }
          sketchState.currentPoints = [];
          renderSketchCanvas();
        }

        canvas.addEventListener('pointerup', finishStroke);
        canvas.addEventListener('pointercancel', finishStroke);
      }

