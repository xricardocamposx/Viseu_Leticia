      function buildDiaryPlainText() {
        var title = (state.diaryTitle || 'Passeio por Viseu — Caderno da Letícia Gomez').trim();
        var lines = [
          title,
          '==================================================',
          'Progresso: ' + state.completedIds.length + '/12 desafios concluídos',
          'Nível: Nv. ' + getLevelInfo(state.completedIds.length).level + ' · ' + getLevelInfo(state.completedIds.length).name,
          ''
        ];

        CHALLENGES.forEach(function (c) {
          var done = isCompleted(c.id);
          var rec = getStopRecord(c.id);
          var directKm = calculateWalkingDistanceKm(START_HUB.coords, c.coords);
          var directMin = Math.max(1, Math.round(calculateWalkingMinutes(directKm)));
          lines.push(c.code + '. ' + c.nome + ' [' + (done ? 'Concluído — Medalha: ' + c.medalha : 'Por fazer') + ']');
          lines.push('   Morada: ' + c.morada + ' (' + c.coords[0].toFixed(5) + ', ' + c.coords[1].toFixed(5) + ')');
          lines.push('   Do Bairro 1º de Maio: ' + formatSegmentDist(directKm) + ' (~' + directMin + ' min ida)');
          var detCount = rec.details.filter(Boolean).length;
          lines.push('   Detalhes descobertos: ' + detCount + '/4');
          if (rec.sensations.length > 0) {
            lines.push('   Sensações: ' + rec.sensations.join(', '));
          }
          if (rec.notes && rec.notes.trim()) {
            lines.push('   Notas: ' + rec.notes.trim());
          }
          if (rec.strokes && rec.strokes.length > 0) {
            lines.push('   Esboço tátil: ' + rec.strokes.length + ' traços guardados');
          }
          lines.push('');
        });

        return lines.join('\n');
      }

      function exportDiaryTxt() {
        var content = buildDiaryPlainText();
        var filename = 'passeio-viseu-leticia.txt';
        if (window.notebookAppApi && typeof window.notebookAppApi.triggerFileDownload === 'function') {
          window.notebookAppApi.triggerFileDownload({
            content: content,
            contentType: 'text/plain',
            encoding: 'UTF-8',
            filename: filename
          });
          showToast('Diário exportado como ' + filename);
        } else {
          var blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
          var url = URL.createObjectURL(blob);
          var a = document.createElement('a');
          a.href = url;
          a.download = filename;
          a.click();
          URL.revokeObjectURL(url);
          showToast('Diário exportado! 💜');
        }
      }

