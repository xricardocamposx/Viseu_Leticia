        var removePhotoBtn = document.getElementById('removePhotoBtn');
        if (removePhotoBtn) {
          removePhotoBtn.addEventListener('click', function () {
            var prev = sessionPhotos[String(state.activeModalStopId)];
            if (prev && prev.url) URL.revokeObjectURL(prev.url);
            delete sessionPhotos[String(state.activeModalStopId)];
            renderStopModalContent();
            renderItineraryList();
          });
        }

        document.querySelectorAll('[data-ink-color]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            sketchState.inkKey = btn.getAttribute('data-ink-color');
            document.querySelectorAll('[data-ink-color]').forEach(function (b) {
              b.classList.toggle('is-active', b === btn);
            });
          });
        });

        var thinBtn = document.getElementById('strokeThinBtn');
        var thickBtn = document.getElementById('strokeThickBtn');
        if (thinBtn && thickBtn) {
          thinBtn.addEventListener('click', function () {
            sketchState.width = 2.8;
            thinBtn.classList.add('is-active');
            thickBtn.classList.remove('is-active');
          });
          thickBtn.addEventListener('click', function () {
            sketchState.width = 6.5;
            thickBtn.classList.add('is-active');
            thinBtn.classList.remove('is-active');
          });
        }

        var undoBtn = document.getElementById('undoSketchBtn');
        if (undoBtn) {
          undoBtn.addEventListener('click', function () {
            var rec = getStopRecord(state.activeModalStopId);
            if (rec.strokes.length > 0) {
              rec.strokes.pop();
              savePersistedState();
              renderSketchCanvas();
            }
          });
        }

        var clearSketchBtn = document.getElementById('clearSketchBtn');
        if (clearSketchBtn) {
          clearSketchBtn.addEventListener('click', function () {
            var rec = getStopRecord(state.activeModalStopId);
            rec.strokes = [];
            savePersistedState();
            renderSketchCanvas();
          });
        }

        var celContinue = document.getElementById('celebrationContinueBtn');
        if (celContinue) {
          celContinue.addEventListener('click', function () {
            var m = document.getElementById('celebrationModal');
            if (m) m.classList.add('is-hidden');
          });
        }
        var celAwards = document.getElementById('celebrationAwardsBtn');
        if (celAwards) {
          celAwards.addEventListener('click', function () {
            var m = document.getElementById('celebrationModal');
            if (m) m.classList.add('is-hidden');
            closeStopModal();
            openAwardsModal();
          });
        }

        var openAwardsBtn = document.getElementById('openAwardsBtn');
        if (openAwardsBtn) openAwardsBtn.addEventListener('click', openAwardsModal);
        var closeAwardsBtn = document.getElementById('closeAwardsModalBtn');
        if (closeAwardsBtn) closeAwardsBtn.addEventListener('click', closeAwardsModal);

        var openMapsGuideBtn = document.getElementById('openMapsGuideBtn');
        if (openMapsGuideBtn) openMapsGuideBtn.addEventListener('click', openMapsGuideModal);
        var closeMapsGuideBtn = document.getElementById('closeMapsGuideBtn');
        if (closeMapsGuideBtn) closeMapsGuideBtn.addEventListener('click', closeMapsGuideModal);

        var openDiaryBtn = document.getElementById('openDiaryBtn');
        if (openDiaryBtn) openDiaryBtn.addEventListener('click', openDiaryModal);
        var closeDiaryBtn = document.getElementById('closeDiaryModalBtn');
        if (closeDiaryBtn) {
          closeDiaryBtn.addEventListener('click', function () {
            var m = document.getElementById('diaryModal');
            if (m) m.classList.add('is-hidden');
          });
        }

        var diaryTitleInp = document.getElementById('diaryTitleInput');
        if (diaryTitleInp) {
          diaryTitleInp.addEventListener('input', function () {
            state.diaryTitle = diaryTitleInp.value;
            savePersistedState();
          });
        }

        var printBtn = document.getElementById('printPdfBtn');
        if (printBtn) {
          printBtn.addEventListener('click', function () {
            var m = document.getElementById('diaryModal');
            if (m) m.classList.add('is-hidden');
            window.print();
          });
        }

        var exportBtn = document.getElementById('exportTxtBtn');
        if (exportBtn) exportBtn.addEventListener('click', exportDiaryTxt);

        var resetBtn = document.getElementById('resetNotebookBtn');
        if (resetBtn) {
          resetBtn.addEventListener('click', function () {
            if (resetBtn.dataset.armed !== 'true') {
              resetBtn.dataset.armed = 'true';
              resetBtn.textContent = 'Clica outra vez para confirmar';
              return;
            }
            resetBtn.dataset.armed = 'false';
            resetBtn.textContent = 'Reiniciar';
            state.completedIds = [];
            state.redeemedRewards = [];
            state.records = {};
            state.diaryTitle = '';
            sessionPhotos = {};
            savePersistedState();
            renderAll(false);
            var m = document.getElementById('diaryModal');
            if (m) m.classList.add('is-hidden');
            showToast('Caderno reiniciado.');
          });
        }

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            closeStopModal();
            closeAwardsModal();
            closeMapsGuideModal();
            var m1 = document.getElementById('celebrationModal');
            var m3 = document.getElementById('diaryModal');
            if (m1) m1.classList.add('is-hidden');
            if (m3) m3.classList.add('is-hidden');
          }
        });

        window.addEventListener('resize', function () {
          if (map) map.invalidateSize();
        });
      }

      window.handleCardClick = handleCardClick;
      window.focusStopFromCard = focusStopFromCard;
      window.focusIndividualFromCard = focusIndividualFromCard;
      window.selectIndividualDestination = selectIndividualDestination;
      window.switchToIndividualForStop = switchToIndividualForStop;
      window.openStopModal = openStopModal;
      window.openStopModalFromMap = openStopModalFromMap;
      window.clearAllFilters = clearAllFilters;
      window.toggleDetailItem = toggleDetailItem;
      window.toggleSensation = toggleSensation;
      window.toggleRedeemedReward = toggleRedeemedReward;
      window.closeAwardsModal = closeAwardsModal;
      window.closeMapsGuideModal = closeMapsGuideModal;
      window.copyIndividualCoords = copyIndividualCoords;
      window.copyStageText = copyStageText;

      async function boot() {
        await loadPersistedState();
        initMap();
        initSketchPadEvents();
        bindEvents();
        renderAll(true);
        if (window.notebookAppApi && typeof window.notebookAppApi.notifyAppReady === 'function') {
          window.notebookAppApi.notifyAppReady();
        }
      }

      document.addEventListener('DOMContentLoaded', boot);
    })();
  </script>
</body>
</html>
